<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Best Friends Quiz 💜</title>
  <meta name="description" content="¿Quién te conoce de verdad? Crea tu test y descubre quién es tu mejor amigo." />
  <meta name="theme-color" content="#0f0a1a" />
  <style>
    :root {
      --bg: #0a0614;
      --bg-card: #130c22;
      --primary: #8B5CF6;
      --primary-glow: rgba(139, 92, 246, 0.45);
      --secondary: #22D3EE;
      --secondary-glow: rgba(34, 211, 238, 0.35);
      --text: #f5f3ff;
      --text-muted: #a78bfa;
      --success: #34d399;
      --danger: #f87171;
      --radius: 18px;
      --shadow: 0 0 30px var(--primary-glow);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      height: 100%;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0a0614;
      color: #f5f3ff;
      overflow-x: hidden;
    }

    body {
      background: #0a0614;
      min-height: 100vh;
      min-height: 100dvh;
    }

    /* ===== LAYOUT ===== */
    #app {
      max-width: 480px;
      margin: 0 auto;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      padding: 16px;
      position: relative;
    }

    .screen {
      display: none !important;
      flex-direction: column;
      flex: 1;
      animation: fadeIn 0.35s ease;
    }

    .screen.active {
      display: flex !important;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ===== TYPOGRAPHY ===== */
    h1 {
      font-family: system-ui, -apple-system, sans-serif;
      font-weight: 700;
      font-size: 1.85rem;
      letter-spacing: -0.03em;
      line-height: 1.15;
      color: #f5f3ff;
    }

    h2 {
      font-family: system-ui, -apple-system, sans-serif;
      font-weight: 600;
      font-size: 1.35rem;
      color: #f5f3ff;
    }

    .subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-top: 6px;
      line-height: 1.4;
    }

    /* ===== BUTTONS ===== */
    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 16px 20px;
      border: none;
      border-radius: 14px;
      font-family: inherit;
      font-size: 1.05rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
      overflow: hidden;
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn-primary {
      background: linear-gradient(135deg, #8B5CF6, #7C3AED);
      color: white;
      box-shadow: 0 4px 20px var(--primary-glow), inset 0 1px 0 rgba(255,255,255,0.15);
    }

    .btn-primary:hover {
      box-shadow: 0 6px 28px var(--primary-glow);
    }

    .btn-secondary {
      background: transparent;
      color: var(--secondary);
      border: 2px solid var(--secondary);
      box-shadow: 0 0 15px var(--secondary-glow);
    }

    .btn-secondary:hover {
      background: rgba(34, 211, 238, 0.1);
    }

    .btn-ghost {
      background: rgba(139, 92, 246, 0.12);
      color: var(--text);
      border: 1px solid rgba(139, 92, 246, 0.3);
    }

    .btn:disabled {
      opacity: 0.45;
      pointer-events: none;
    }

    /* ===== CARDS ===== */
    .card {
      background: var(--bg-card);
      border: 1px solid rgba(139, 92, 246, 0.25);
      border-radius: var(--radius);
      padding: 20px;
      box-shadow: 0 0 25px rgba(139, 92, 246, 0.08);
    }

    /* ===== INPUTS ===== */
    .input-group {
      margin-bottom: 16px;
    }

    .input-group label {
      display: block;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 6px;
      font-weight: 500;
    }

    input[type="text"] {
      width: 100%;
      padding: 15px 16px;
      background: rgba(0,0,0,0.35);
      border: 2px solid rgba(139, 92, 246, 0.3);
      border-radius: 12px;
      color: var(--text);
      font-size: 1.05rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    input[type="text"]:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-glow);
    }

    input[type="text"]::placeholder {
      color: rgba(167, 139, 250, 0.5);
    }

    /* ===== HOME ===== */
    #screen-home {
      justify-content: center;
      text-align: center;
      gap: 28px;
    }

    .logo {
      font-family: system-ui, -apple-system, sans-serif;
      font-size: 2.4rem;
      font-weight: 800;
      color: #c4b5fd;
      letter-spacing: -0.03em;
      line-height: 1.15;
      text-shadow: 0 0 30px rgba(139, 92, 246, 0.6);
    }

    .logo span {
      display: block;
      font-size: 1.05rem;
      font-weight: 500;
      margin-top: 8px;
      color: #a78bfa;
      text-shadow: none;
    }

    .tagline {
      font-size: 1.15rem;
      color: var(--text-muted);
      max-width: 280px;
      margin: 0 auto;
    }

    .home-actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
    }

    /* ===== CREATE ===== */
    .progress-bar-container {
      height: 6px;
      background: rgba(139, 92, 246, 0.2);
      border-radius: 99px;
      overflow: hidden;
      margin-bottom: 20px;
    }

    .progress-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--primary), var(--secondary));
      border-radius: 99px;
      transition: width 0.35s ease;
      box-shadow: 0 0 12px var(--primary-glow);
    }

    .question-counter {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 8px;
      font-weight: 500;
    }

    .question-text {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 22px;
      line-height: 1.35;
    }

    .options {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .option {
      padding: 16px 18px;
      background: rgba(0,0,0,0.3);
      border: 2px solid rgba(139, 92, 246, 0.25);
      border-radius: 14px;
      font-size: 1.05rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      text-align: left;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .option:hover, .option:active {
      border-color: var(--primary);
      background: rgba(139, 92, 246, 0.12);
    }

    .option.selected {
      border-color: var(--primary);
      background: rgba(139, 92, 246, 0.22);
      box-shadow: 0 0 18px var(--primary-glow);
    }

    .option.correct {
      border-color: var(--success);
      background: rgba(52, 211, 153, 0.15);
    }

    .option.wrong {
      border-color: var(--danger);
      background: rgba(248, 113, 113, 0.12);
    }

    .option-letter {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: rgba(139, 92, 246, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.9rem;
      flex-shrink: 0;
    }

    .option.selected .option-letter {
      background: var(--primary);
      color: white;
    }

    .nav-buttons {
      display: flex;
      gap: 12px;
      margin-top: 24px;
    }

    .nav-buttons .btn {
      flex: 1;
    }

    /* ===== RESULTS ===== */
    .result-score {
      font-size: 4.2rem;
      font-weight: 800;
      font-family: system-ui, -apple-system, sans-serif;
      color: #c4b5fd;
      line-height: 1;
      margin: 8px 0;
      text-shadow: 0 0 40px rgba(139, 92, 246, 0.5);
    }

    .result-title {
      font-size: 1.4rem;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .result-desc {
      color: var(--text-muted);
      margin-bottom: 24px;
    }

    .medal {
      font-size: 3.5rem;
      margin-bottom: 8px;
    }

    /* ===== RANKING ===== */
    .rank-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .rank-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 16px;
      background: rgba(0,0,0,0.3);
      border-radius: 14px;
      border: 1px solid rgba(139, 92, 246, 0.2);
    }

    .rank-item.top1 {
      border-color: #fbbf24;
      background: rgba(251, 191, 36, 0.1);
    }

    .rank-item.top2 {
      border-color: #94a3b8;
      background: rgba(148, 163, 184, 0.1);
    }

    .rank-item.top3 {
      border-color: #d97706;
      background: rgba(217, 119, 6, 0.1);
    }

    .rank-pos {
      font-weight: 800;
      font-size: 1.15rem;
      width: 32px;
      text-align: center;
    }

    .rank-name {
      flex: 1;
      font-weight: 600;
    }

    .rank-score {
      font-weight: 700;
      color: var(--secondary);
    }

    /* ===== SHARE ===== */
    .share-box {
      background: rgba(0,0,0,0.35);
      border: 1px dashed rgba(139, 92, 246, 0.4);
      border-radius: 12px;
      padding: 14px;
      word-break: break-all;
      font-size: 0.9rem;
      color: var(--text-muted);
      margin: 16px 0;
      text-align: center;
    }

    .share-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* ===== HEADER ===== */
    .screen-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }

    .back-btn {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: rgba(139, 92, 246, 0.15);
      border: 1px solid rgba(139, 92, 246, 0.3);
      color: var(--text);
      font-size: 1.2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
    }

    /* ===== MISC ===== */
    .center {
      text-align: center;
    }

    .mt-auto {
      margin-top: auto;
    }

    .spacer {
      flex: 1;
    }

    .glow-text {
      text-shadow: 0 0 20px var(--primary-glow);
    }

    .footer-note {
      font-size: 0.75rem;
      color: rgba(167, 139, 250, 0.5);
      text-align: center;
      margin-top: 20px;
    }

    /* Toast */
    #toast {
      position: fixed;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: var(--bg-card);
      border: 1px solid var(--primary);
      color: var(--text);
      padding: 12px 22px;
      border-radius: 12px;
      font-weight: 600;
      box-shadow: var(--shadow);
      opacity: 0;
      transition: all 0.3s ease;
      z-index: 100;
      pointer-events: none;
    }

    #toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* Confetti-ish particles for results */
    .particles {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 0;
    }
  </style>
</head>
<body>
  <div id="app">
    <!-- ========== HOME ========== -->
    <div id="screen-home" class="screen active">
      <div class="spacer"></div>
      <div class="logo">Best Friends<br>Quiz <span>💜 ¿Quién te conoce de verdad?</span></div>
      <p class="tagline">Crea tu test, compártelo y descubre quién es tu verdadero mejor amigo.</p>
      <div class="home-actions">
        <button class="btn btn-primary" onclick="startCreate()">✨ Crear mi test</button>
        <button class="btn btn-secondary" onclick="showJoin()">🔗 Responder un reto</button>
      </div>
      <div class="spacer"></div>
      <p class="footer-note">Hecho con 💜 · Funciona offline</p>
    </div>

    <!-- ========== JOIN (pegar enlace o código) ========== -->
    <div id="screen-join" class="screen">
      <div class="screen-header">
        <button class="back-btn" onclick="showScreen('home')">←</button>
        <h2>Responder un reto</h2>
      </div>
      <p class="subtitle" style="margin-bottom:20px">Pega el enlace que te compartieron o el código del reto.</p>
      <div class="input-group">
        <label>Enlace o código</label>
        <input type="text" id="join-input" placeholder="bestfriendsquiz.com/q/..." />
      </div>
      <button class="btn btn-primary" onclick="joinQuiz()">Empezar a responder</button>
    </div>

    <!-- ========== CREATE: NOMBRE ========== -->
    <div id="screen-create-name" class="screen">
      <div class="screen-header">
        <button class="back-btn" onclick="showScreen('home')">←</button>
        <h2>Crear mi test</h2>
      </div>
      <p class="subtitle" style="margin-bottom:24px">¿Cómo te llamas? Tus amigos verán este nombre.</p>
      <div class="input-group">
        <label>Tu nombre</label>
        <input type="text" id="creator-name" placeholder="Ej: Ana" maxlength="20" />
      </div>
      <button class="btn btn-primary mt-auto" onclick="startCreateQuestions()">Siguiente →</button>
    </div>

    <!-- ========== CREATE: PREGUNTAS ========== -->
    <div id="screen-create-q" class="screen">
      <div class="progress-bar-container">
        <div class="progress-bar" id="create-progress" style="width:0%"></div>
      </div>
      <div class="question-counter" id="create-counter">Pregunta 1 de 15</div>
      <div class="question-text" id="create-question"></div>
      <div class="options" id="create-options"></div>
      <div class="nav-buttons">
        <button class="btn btn-ghost" id="create-prev" onclick="createPrev()" disabled>Anterior</button>
        <button class="btn btn-primary" id="create-next" onclick="createNext()" disabled>Siguiente</button>
      </div>
    </div>

    <!-- ========== SHARE (después de crear) ========== -->
    <div id="screen-share" class="screen">
      <div class="center">
        <div class="medal">🔗</div>
        <h1 class="glow-text">¡Tu reto está listo!</h1>
        <p class="subtitle" style="margin:12px 0 8px">Comparte este enlace con tus amigos</p>
      </div>
      <div class="share-box" id="share-link"></div>
      <div class="share-actions">
        <button class="btn btn-primary" onclick="shareWhatsApp()">📱 Compartir por WhatsApp</button>
        <button class="btn btn-secondary" onclick="copyLink()">📋 Copiar enlace</button>
        <button class="btn btn-ghost" onclick="viewMyRanking()">🏆 Ver ranking de mi reto</button>
        <button class="btn btn-ghost" onclick="showScreen('home')">← Volver al inicio</button>
      </div>
    </div>

    <!-- ========== ANSWER: NOMBRE ========== -->
    <div id="screen-answer-name" class="screen">
      <div class="screen-header">
        <button class="back-btn" onclick="showScreen('home')">←</button>
        <h2>Reto de <span id="quiz-creator-name">...</span></h2>
      </div>
      <p class="subtitle" style="margin-bottom:24px">¿Qué tan bien lo/la conoces? Escribe tu nombre para empezar.</p>
      <div class="input-group">
        <label>Tu nombre</label>
        <input type="text" id="player-name" placeholder="Tu nombre" maxlength="20" />
      </div>
      <button class="btn btn-primary mt-auto" onclick="startAnswering()">¡Empezar el test!</button>
    </div>

    <!-- ========== ANSWER: PREGUNTAS ========== -->
    <div id="screen-answer-q" class="screen">
      <div class="progress-bar-container">
        <div class="progress-bar" id="answer-progress" style="width:0%"></div>
      </div>
      <div class="question-counter" id="answer-counter">Pregunta 1 de 15</div>
      <div class="question-text" id="answer-question"></div>
      <div class="options" id="answer-options"></div>
      <div class="nav-buttons">
        <button class="btn btn-ghost" id="answer-prev" onclick="answerPrev()" disabled>Anterior</button>
        <button class="btn btn-primary" id="answer-next" onclick="answerNext()" disabled>Siguiente</button>
      </div>
    </div>

    <!-- ========== RESULTS ========== -->
    <div id="screen-results" class="screen">
      <div class="center" style="margin-top:20px">
        <div class="medal" id="result-emoji">🏆</div>
        <div class="result-score" id="result-percent">0%</div>
        <div class="result-title" id="result-title">Desconocido 👀</div>
        <p class="result-desc" id="result-desc">Aciertos: 0 de 15</p>
      </div>
      <div class="share-actions">
        <button class="btn btn-primary" onclick="showRanking()">🏆 Ver ranking</button>
        <button class="btn btn-secondary" onclick="shareResult()">📤 Compartir mi resultado</button>
        <button class="btn btn-ghost" onclick="showScreen('home')">← Inicio</button>
      </div>
    </div>

    <!-- ========== RANKING ========== -->
    <div id="screen-ranking" class="screen">
      <div class="screen-header">
        <button class="back-btn" onclick="goBackFromRanking()">←</button>
        <h2>Ranking · <span id="ranking-creator"></span></h2>
      </div>
      <p class="subtitle" style="margin-bottom:16px">Ordenado por aciertos y tiempo</p>
      <div class="rank-list" id="rank-list">
        <!-- filled by JS -->
      </div>
      <div class="spacer"></div>
      <button class="btn btn-ghost mt-auto" onclick="showScreen('home')">← Volver al inicio</button>
    </div>
  </div>

  <div id="toast"></div>

  <script>
    // ===================== DATA =====================
    const QUESTIONS = [
      {
        q: "¿Cuál es mi comida favorita?",
        options: ["Pizza", "Hamburguesa", "Sushi", "Tacos"]
      },
      {
        q: "¿Cuál es mi color favorito?",
        options: ["Morado", "Azul", "Negro", "Verde"]
      },
      {
        q: "¿Cuál es mi película favorita?",
        options: ["Interestelar", "El Rey León", "Avengers", "Titanic"]
      },
      {
        q: "¿Cómo prefiero pasar un fin de semana?",
        options: ["Netflix en casa", "Salir con amigos", "Viajar", "Hacer deporte"]
      },
      {
        q: "¿Cuál es mi estación del año favorita?",
        options: ["Verano", "Invierno", "Primavera", "Otoño"]
      },
      {
        q: "¿Qué superpoder me gustaría tener?",
        options: ["Volar", "Leer la mente", "Invisibilidad", "Viajar en el tiempo"]
      },
      {
        q: "¿Cuál es mi animal favorito?",
        options: ["Perro", "Gato", "Lobo", "Delfín"]
      },
      {
        q: "¿Dónde me gustaría viajar?",
        options: ["Japón", "Italia", "Islandia", "México"]
      },
      {
        q: "¿Cuál es mi postre favorito?",
        options: ["Helado", "Chocolate", "Cheesecake", "Flan"]
      },
      {
        q: "¿Qué tipo de música escucho más?",
        options: ["Pop", "Reggaetón", "Rock", "Electrónica"]
      },
      {
        q: "¿Soy más de...?",
        options: ["Mañana (madrugador)", "Noche (noctámbulo)", "Tarde", "Depende del día"]
      },
      {
        q: "¿Cuál es mi mayor miedo?",
        options: ["Alturas", "Arañas", "Fracaso", "Soledad"]
      },
      {
        q: "¿Qué me hace más feliz?",
        options: ["Pasar tiempo con amigos", "Comer rico", "Viajar", "Lograr mis metas"]
      },
      {
        q: "¿Cuál es mi red social favorita?",
        options: ["Instagram", "TikTok", "WhatsApp", "X (Twitter)"]
      },
      {
        q: "Si tuviera que describirme en una palabra, sería...",
        options: ["Divertido/a", "Leal", "Creativo/a", "Aventurero/a"]
      }
    ];

    const TITLES = [
      { min: 0,  max: 5,  title: "Desconocido 👀", emoji: "👀" },
      { min: 6,  max: 9,  title: "Amigo en entrenamiento 🤝", emoji: "🤝" },
      { min: 10, max: 12, title: "Amigo de confianza 🔥", emoji: "🔥" },
      { min: 13, max: 14, title: "Mejor amigo 🏆", emoji: "🏆" },
      { min: 15, max: 15, title: "Leyenda de la amistad 💜", emoji: "💜" }
    ];

    // ===================== STATE =====================
    let state = {
      mode: null,           // 'create' | 'answer'
      creatorName: '',
      createAnswers: [],    // indices 0-3 for each question
      createIndex: 0,
      currentQuiz: null,    // { id, creator, answers }
      playerName: '',
      playerAnswers: [],
      answerIndex: 0,
      startTime: 0,
      lastResult: null
    };

    // ===================== HELPERS =====================
    function showScreen(id) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      document.getElementById('screen-' + id).classList.add('active');
      window.scrollTo(0, 0);
    }

    function toast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2200);
    }

    function encodeQuiz(quiz) {
      return btoa(unescape(encodeURIComponent(JSON.stringify(quiz))));
    }

    function decodeQuiz(str) {
      try {
        return JSON.parse(decodeURIComponent(escape(atob(str))));
      } catch (e) {
        return null;
      }
    }

    function generateId() {
      return Math.random().toString(36).substring(2, 10);
    }

    function getTitle(score) {
      return TITLES.find(t => score >= t.min && score <= t.max) || TITLES[0];
    }

    function saveAttempt(quizId, attempt) {
      const key = 'bfq_' + quizId;
      let list = JSON.parse(localStorage.getItem(key) || '[]');
      // evitar duplicados por nombre (actualizar si existe)
      const idx = list.findIndex(a => a.name.toLowerCase() === attempt.name.toLowerCase());
      if (idx >= 0) list[idx] = attempt;
      else list.push(attempt);
      // ordenar: más aciertos primero, luego menos tiempo
      list.sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score;
        return a.time - b.time;
      });
      localStorage.setItem(key, JSON.stringify(list));
      return list;
    }

    function getAttempts(quizId) {
      return JSON.parse(localStorage.getItem('bfq_' + quizId) || '[]');
    }

    function getShareUrl(quiz) {
      const encoded = encodeQuiz(quiz);
      const base = location.href.split('#')[0].split('?')[0];
      return base + '#q=' + encoded;
    }

    // ===================== HOME / JOIN =====================
    function startCreate() {
      state.creatorName = '';
      state.createAnswers = new Array(15).fill(null);
      state.createIndex = 0;
      document.getElementById('creator-name').value = '';
      showScreen('create-name');
    }

    function showJoin() {
      document.getElementById('join-input').value = '';
      showScreen('join');
    }

    function joinQuiz() {
      let input = document.getElementById('join-input').value.trim();
      if (!input) return toast('Pega un enlace o código');

      // extraer de URL completa o solo el hash
      let encoded = input;
      if (input.includes('#q=')) {
        encoded = input.split('#q=')[1];
      } else if (input.includes('q=')) {
        encoded = input.split('q=')[1];
      }

      const quiz = decodeQuiz(encoded);
      if (!quiz || !quiz.answers || quiz.answers.length !== 15) {
        return toast('Enlace inválido 😕');
      }
      loadQuiz(quiz);
    }

    function loadQuiz(quiz) {
      state.currentQuiz = quiz;
      state.playerAnswers = new Array(15).fill(null);
      state.answerIndex = 0;
      document.getElementById('quiz-creator-name').textContent = quiz.creator;
      document.getElementById('player-name').value = '';
      showScreen('answer-name');
    }

    // ===================== CREATE FLOW =====================
    function startCreateQuestions() {
      const name = document.getElementById('creator-name').value.trim();
      if (!name) return toast('Escribe tu nombre');
      state.creatorName = name;
      state.createIndex = 0;
      renderCreateQuestion();
      showScreen('create-q');
    }

    function renderCreateQuestion() {
      const i = state.createIndex;
      const q = QUESTIONS[i];
      document.getElementById('create-counter').textContent = `Pregunta ${i + 1} de 15`;
      document.getElementById('create-progress').style.width = ((i + 1) / 15 * 100) + '%';
      document.getElementById('create-question').textContent = q.q;

      const container = document.getElementById('create-options');
      container.innerHTML = '';
      q.options.forEach((opt, idx) => {
        const div = document.createElement('div');
        div.className = 'option' + (state.createAnswers[i] === idx ? ' selected' : '');
        div.innerHTML = `<span class="option-letter">${String.fromCharCode(65 + idx)}</span> ${opt}`;
        div.onclick = () => {
          state.createAnswers[i] = idx;
          renderCreateQuestion();
          document.getElementById('create-next').disabled = false;
        };
        container.appendChild(div);
      });

      document.getElementById('create-prev').disabled = i === 0;
      document.getElementById('create-next').disabled = state.createAnswers[i] === null;
      document.getElementById('create-next').textContent = i === 14 ? 'Generar reto ✨' : 'Siguiente';
    }

    function createPrev() {
      if (state.createIndex > 0) {
        state.createIndex--;
        renderCreateQuestion();
      }
    }

    function createNext() {
      if (state.createAnswers[state.createIndex] === null) return;
      if (state.createIndex < 14) {
        state.createIndex++;
        renderCreateQuestion();
      } else {
        // generar quiz
        const quiz = {
          id: generateId(),
          creator: state.creatorName,
          answers: [...state.createAnswers]
        };
        state.currentQuiz = quiz;
        const url = getShareUrl(quiz);
        document.getElementById('share-link').textContent = url;
        showScreen('share');
      }
    }

    // ===================== ANSWER FLOW =====================
    function startAnswering() {
      const name = document.getElementById('player-name').value.trim();
      if (!name) return toast('Escribe tu nombre');
      state.playerName = name;
      state.answerIndex = 0;
      state.startTime = Date.now();
      renderAnswerQuestion();
      showScreen('answer-q');
    }

    function renderAnswerQuestion() {
      const i = state.answerIndex;
      const q = QUESTIONS[i];
      document.getElementById('answer-counter').textContent = `Pregunta ${i + 1} de 15`;
      document.getElementById('answer-progress').style.width = ((i + 1) / 15 * 100) + '%';
      document.getElementById('answer-question').textContent = q.q;

      const container = document.getElementById('answer-options');
      container.innerHTML = '';
      q.options.forEach((opt, idx) => {
        const div = document.createElement('div');
        div.className = 'option' + (state.playerAnswers[i] === idx ? ' selected' : '');
        div.innerHTML = `<span class="option-letter">${String.fromCharCode(65 + idx)}</span> ${opt}`;
        div.onclick = () => {
          state.playerAnswers[i] = idx;
          renderAnswerQuestion();
          document.getElementById('answer-next').disabled = false;
        };
        container.appendChild(div);
      });

      document.getElementById('answer-prev').disabled = i === 0;
      document.getElementById('answer-next').disabled = state.playerAnswers[i] === null;
      document.getElementById('answer-next').textContent = i === 14 ? 'Ver resultados 🏆' : 'Siguiente';
    }

    function answerPrev() {
      if (state.answerIndex > 0) {
        state.answerIndex--;
        renderAnswerQuestion();
      }
    }

    function answerNext() {
      if (state.playerAnswers[state.answerIndex] === null) return;
      if (state.answerIndex < 14) {
        state.answerIndex++;
        renderAnswerQuestion();
      } else {
        finishQuiz();
      }
    }

    function finishQuiz() {
      const correct = state.currentQuiz.answers;
      let score = 0;
      for (let i = 0; i < 15; i++) {
        if (state.playerAnswers[i] === correct[i]) score++;
      }
      const percent = Math.round((score / 15) * 100);
      const titleObj = getTitle(score);
      const time = Math.round((Date.now() - state.startTime) / 1000);

      const attempt = {
        name: state.playerName,
        score,
        percent,
        time,
        timestamp: Date.now()
      };

      saveAttempt(state.currentQuiz.id, attempt);
      state.lastResult = { ...attempt, title: titleObj.title, emoji: titleObj.emoji };

      document.getElementById('result-percent').textContent = percent + '%';
      document.getElementById('result-title').textContent = titleObj.title;
      document.getElementById('result-emoji').textContent = titleObj.emoji;
      document.getElementById('result-desc').textContent = `Aciertos: ${score} de 15 · ${time}s`;

      showScreen('results');
    }

    // ===================== RANKING & SHARE =====================
    function showRanking() {
      renderRanking();
      showScreen('ranking');
    }

    function viewMyRanking() {
      renderRanking();
      showScreen('ranking');
    }

    function renderRanking() {
      const quiz = state.currentQuiz;
      document.getElementById('ranking-creator').textContent = quiz.creator;
      const list = getAttempts(quiz.id);
      const container = document.getElementById('rank-list');

      if (list.length === 0) {
        container.innerHTML = '<p class="subtitle center" style="padding:30px 0">Aún no hay intentos.<br>¡Comparte el enlace!</p>';
        return;
      }

      container.innerHTML = list.map((a, i) => {
        let cls = '';
        let medal = (i + 1);
        if (i === 0) { cls = 'top1'; medal = '🥇'; }
        else if (i === 1) { cls = 'top2'; medal = '🥈'; }
        else if (i === 2) { cls = 'top3'; medal = '🥉'; }

        return `
          <div class="rank-item ${cls}">
            <div class="rank-pos">${medal}</div>
            <div class="rank-name">${escapeHtml(a.name)}</div>
            <div class="rank-score">${a.score}/15 · ${a.percent}%</div>
          </div>
        `;
      }).join('');
    }

    function goBackFromRanking() {
      if (state.lastResult) showScreen('results');
      else showScreen('share');
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      })[m]);
    }

    function copyLink() {
      const url = document.getElementById('share-link').textContent;
      navigator.clipboard.writeText(url).then(() => toast('¡Enlace copiado!')).catch(() => {
        // fallback
        const ta = document.createElement('textarea');
        ta.value = url;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        toast('¡Enlace copiado!');
      });
    }

    function shareWhatsApp() {
      const url = document.getElementById('share-link').textContent;
      const text = `¡Responde mi Best Friends Quiz y demuestra cuánto me conoces! 💜\n\n${url}`;
      window.open('https://wa.me/?text=' + encodeURIComponent(text), '_blank');
    }

    function shareResult() {
      const r = state.lastResult;
      const quiz = state.currentQuiz;
      const text = `¡Saqué ${r.percent}% en el Best Friends Quiz de ${quiz.creator}!\n${r.title}\n\n¿Puedes superarme?`;
      if (navigator.share) {
        navigator.share({ text }).catch(() => {});
      } else {
        const url = getShareUrl(quiz);
        window.open('https://wa.me/?text=' + encodeURIComponent(text + '\n' + url), '_blank');
      }
    }

    // ===================== INIT: detectar quiz en URL =====================
    function initFromUrl() {
      const hash = location.hash;
      if (hash.startsWith('#q=')) {
        const encoded = hash.substring(3);
        const quiz = decodeQuiz(encoded);
        if (quiz && quiz.answers && quiz.answers.length === 15) {
          loadQuiz(quiz);
        }
      }
    }

    // Arrancar
    initFromUrl();
  </script>
</body>
</html>
